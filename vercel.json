{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views/**,public/**,template*.tex,*.png,logo.png,Favicon.png.avif,vendor/latex-libs/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**,node_modules/@napi-rs/canvas*/**,node_modules/node-latex-compiler/**,node_modules/@node-latex-compiler/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
