{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views/**,public/**,template*.tex,*.png,*.avif,*.pdf,vendor/**,node_modules/{pdf-parse,pdfjs-dist,@napi-rs/**,node-latex-compiler,@node-latex-compiler}/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
